#cloud-config
# Provisioning template for koch test VMs. Rendered by vm/koch-vm:
# __SSH_PUBKEY__ is replaced with the contents of vm/id_koch.pub.
#
# This mirrors the old Vagrant shell provisioner: install Ruby so koch can run,
# drop a dummy /etc/secrets.yaml so the example
# Rezeptfile works, and mount the repo (shared via virtiofs, tag "koch") at
# /koch. The koch gem itself is installed by `vm/koch-vm apply`, not here, so
# koch can be re-tested without reprovisioning the VM.
users:
  - name: koch
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
      - __SSH_PUBKEY__
package_update: true
packages:
  - ruby
write_files:
  - path: /etc/secrets.yaml
    permissions: "0600"
    content: |
      ---
      restic:
        password: test123
runcmd:
  - mkdir -p /koch
  - grep -q '^koch /koch ' /etc/fstab || echo 'koch /koch virtiofs defaults 0 0' >> /etc/fstab
  - mountpoint -q /koch || mount -t virtiofs koch /koch
